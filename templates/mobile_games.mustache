{{!
    @template local_oksigeniatesape/mobile_games

    The games of the user in the Moodle app: each with its mission, where the class is and its ways in, which open the
    game inside the app.

    Example context (json):
    {
        "hasgames": true, "none": "Todavía no juegas en ningún curso.",
        "hint": "El juego se abre dentro de la app.",
        "games": [{"name": "Ciencias 5.º A", "mission": "Los seres vivos", "line": "La clase está en El Gran Lago: 3 de 6 linternas.",
            "note": "", "image": "https://example.org/map.webp",
            "buttons": [{"url": "https://example.org/local/oksigeniatesape/play.php?id=2", "label": "Entrar en el valle", "main": true}]}]
    }
}}
<div class="local-oksigeniatesape-mobile">
{{^hasgames}}<ion-list><ion-item><ion-label class="ion-text-wrap">{{none}}</ion-label></ion-item></ion-list>{{/hasgames}}
{{#games}}
    <ion-card>
        {{#image}}<img src="{{image}}" alt="" style="display: block; width: 100%; height: 160px; object-fit: cover;">{{/image}}
        <ion-card-header>
            <ion-card-subtitle>{{name}}</ion-card-subtitle>
            <ion-card-title>{{mission}}</ion-card-title>
        </ion-card-header>
        <ion-card-content>
            {{#line}}<p>{{line}}</p>{{/line}}
            {{#note}}<p><strong>{{note}}</strong></p>{{/note}}
            {{#buttons}}<ion-button expand="block" fill="{{#main}}solid{{/main}}{{^main}}outline{{/main}}" core-link inApp="true" href="{{url}}">{{label}}</ion-button>{{/buttons}}
        </ion-card-content>
    </ion-card>
{{/games}}
{{#hasgames}}<p class="ion-padding-horizontal"><small>{{hint}}</small></p>{{/hasgames}}
</div>
